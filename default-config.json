{
  "superagents": {
    "extensions": [],
    "tools": ["read", "grep", "find", "ls"],
    "commands": {
      "sp-implement": {
        "taskScheduling": "sequential",
        "reviewCadence": "per-task",
        "useSubagents": true,
        "useTestDrivenDevelopment": true,
        "useBranches": true,
        "worktrees": { "enabled": false, "root": null }
      },
      "sp-implement-parallel": {
        "taskScheduling": "parallel",
        "reviewCadence": "per-task",
        "useSubagents": true,
        "useTestDrivenDevelopment": true,
        "useBranches": true,
        "worktrees": { "enabled": false, "root": null }
      },
      "sp-brainstorm": {
        "usePlannotator": true
      },
      "sp-plan": {
        "usePlannotator": true
      }
    },
    "modelTiers": {
      "cheap": {
        "model": "default"
      },
      "balanced": {
        "model": "default",
        "thinking": "high"
      },
      "max": {
        "model": "default",
        "thinking": "high"
      }
    },
    "interceptSkillCommands": ["brainstorming", "writing-plans"],
    "makeSuperpowersSkillsOptInOnly": true
  }
}
